[node name="Body" type="Label" parent="UI/TutorialPanel/VBox" unique_id=2124095736]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.24, 0.22, 0.2, 1)
theme_override_font_sizes/font_size = 9
text = "Alirkan air dari sumber ke setiap bangunan sebelum cadangan airnya habis.

1 Gali  - buat kanal dari tanah.
2 Ratakan - klik kiri turunkan, klik kanan naikkan tanah. Air tidak bisa naik!
3 Timbun - tutup kanal, bongkar jembatan/fasilitas.
4 Jembatan - pasang di jalan agar kanal bisa lewat.
5 Mesin Bor - sumber air tanah saat kemarau.
6 Bendungan - tembok penahan air.
7 Spillway - cegah sumber air meluap saat hujan.

Lihat prakiraan cuaca di kanan atas dan bersiaplah!
(Tutorial interaktif menyusul.)"
autowrap_mode = 3

