[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://ui/pause_menu.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/placeholder/ui/card.png" id="2_card"]

[sub_resource type="StyleBoxTexture" id="StyleBox_btn"]
content_margin_left = 6.0
content_margin_top = 2.0
content_margin_right = 6.0
content_margin_bottom = 2.0
texture = ExtResource("2_card")
texture_margin_left = 4.0
texture_margin_top = 4.0
texture_margin_right = 4.0
texture_margin_bottom = 4.0

[node name="PauseMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.1, 0.14, 0.45)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -75.0
offset_top = -60.0
offset_right = 75.0
offset_bottom = 60.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="Title" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.16, 0.36, 0.6, 1)
theme_override_font_sizes/font_size = 12
text = "Jeda"
horizontal_alignment = 1

[node name="Main" type="VBoxContainer" parent="Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 3

[node name="Resume" type="Button" parent="Panel/VBox/Main"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
focus_mode = 0
theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 9
text = "Lanjutkan"

[node name="Restart" type="Button" parent="Panel/VBox/Main"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
focus_mode = 0
theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 9
text = "Main Ulang"

[node name="Options" type="Button" parent="Panel/VBox/Main"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
focus_mode = 0
theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 9
text = "Pengaturan"

[node name="MainMenu" type="Button" parent="Panel/VBox/Main"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
focus_mode = 0
theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 9
text = "Menu Utama"

[node name="Hint" type="Label" parent="Panel/VBox/Main"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.42, 0.38, 1)
theme_override_font_sizes/font_size = 7
text = "Esc: tutup menu"
horizontal_alignment = 1

[node name="Settings" type="VBoxContainer" parent="Panel/VBox"]
visible = false
layout_mode = 2
theme_override_constants/separation = 3

[node name="Master" type="HBoxContainer" parent="Panel/VBox/Settings"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Label" type="Label" parent="Panel/VBox/Settings/Master"]
custom_minimum_size = Vector2(58, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 8
text = "Volume utama"

[node name="Slider" type="HSlider" parent="Panel/VBox/Settings/Master"]
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
focus_mode = 0
max_value = 1.0
step = 0.05
value = 0.8

[node name="Music" type="HBoxContainer" parent="Panel/VBox/Settings"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Label" type="Label" parent="Panel/VBox/Settings/Music"]
custom_minimum_size = Vector2(58, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 8
text = "Musik"

[node name="Slider" type="HSlider" parent="Panel/VBox/Settings/Music"]
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
focus_mode = 0
max_value = 1.0
step = 0.05
value = 0.8

[node name="SFX" type="HBoxContainer" parent="Panel/VBox/Settings"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Label" type="Label" parent="Panel/VBox/Settings/SFX"]
custom_minimum_size = Vector2(58, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 8
text = "Efek suara"

[node name="Slider" type="HSlider" parent="Panel/VBox/Settings/SFX"]
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
focus_mode = 0
