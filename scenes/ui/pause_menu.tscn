step = 0.05
value = 0.8

[node name="Fullscreen" type="CheckButton" parent="Panel/VBox/Settings"]
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 8
text = "Layar penuh"

[node name="Tooltips" type="CheckButton" parent="Panel/VBox/Settings"]
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 8
button_pressed = true
text = "Tooltip info petak"

[node name="Back" type="Button" parent="Panel/VBox/Settings"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
focus_mode = 0
theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 9
text = "Kembali"

