theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 8
text = "5"

[node name="Saran" type="VBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 1

[node name="Q" type="Label" parent="VBox/Saran"]
layout_mode = 2
theme_override_font_sizes/font_size = 8
text = "Masukan & saran (opsional): apa yang membingungkan, terlalu mudah/sulit, atau ide?"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Text" type="TextEdit" parent="VBox/Saran"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.925, 0.914, 1)
theme_override_colors/font_placeholder_color = Color(0.62, 0.62, 0.6, 1)
theme_override_colors/caret_color = Color(0.62, 0.82, 1, 1)
theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_styles/focus = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 8
placeholder_text = "Tulis di sini..."
wrap_mode = 1

[node name="Send" type="Button" parent="VBox"]
custom_minimum_size = Vector2(60, 16)
layout_mode = 2
size_flags_horizontal = 4
focus_mode = 0
theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 8
text = "Kirim"

[node name="Thanks" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 9
text = "Terima kasih! Jawaban & saran tersimpan di log."
horizontal_alignment = 1
