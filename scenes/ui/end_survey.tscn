custom_minimum_size = Vector2(18, 16)
layout_mode = 2
focus_mode = 0
toggle_mode = true
button_group = SubResource("Group_Tegang")
theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 8
text = "3"

[node name="B4" type="Button" parent="VBox/Tegang/Buttons"]
custom_minimum_size = Vector2(18, 16)
layout_mode = 2
focus_mode = 0
toggle_mode = true
button_group = SubResource("Group_Tegang")
theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 8
text = "4"

[node name="B5" type="Button" parent="VBox/Tegang/Buttons"]
custom_minimum_size = Vector2(18, 16)
layout_mode = 2
