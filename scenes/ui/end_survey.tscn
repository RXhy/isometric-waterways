[gd_scene format=3]

[ext_resource type="Script" path="res://ui/end_survey.gd" id="1_script"]
[ext_resource type="Theme" path="res://ui/hud_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBox_btn"]
content_margin_left = 4.0
content_margin_top = 2.0
content_margin_right = 4.0
content_margin_bottom = 2.0
bg_color = Color(0.161, 0.169, 0.157, 0.0)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 1, 1, 0.1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
corner_detail = 6

[sub_resource type="ButtonGroup" id="Group_Tegang"]

[sub_resource type="ButtonGroup" id="Group_Adil"]

[node name="EndSurvey" type="PanelContainer"]
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -100.0
offset_top = -148.0
offset_right = 100.0
offset_bottom = -8.0
grow_horizontal = 2
grow_vertical = 0
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 3

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.82, 1, 1)
theme_override_font_sizes/font_size = 9
text = "Survei singkat (untuk tim pengembang)"
horizontal_alignment = 1

[node name="Tegang" type="VBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 1

[node name="Q" type="Label" parent="VBox/Tegang"]
layout_mode = 2
theme_override_font_sizes/font_size = 8
text = "Seberapa tegang permainannya? (1 santai - 5 sangat tegang)"
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="VBox/Tegang"]
layout_mode = 2
theme_override_constants/separation = 3
alignment = 1

[node name="B1" type="Button" parent="VBox/Tegang/Buttons"]
custom_minimum_size = Vector2(18, 16)
layout_mode = 2
focus_mode = 0
toggle_mode = true
button_group = SubResource("Group_Tegang")
theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 8
text = "1"

[node name="B2" type="Button" parent="VBox/Tegang/Buttons"]
custom_minimum_size = Vector2(18, 16)
layout_mode = 2
focus_mode = 0
toggle_mode = true
button_group = SubResource("Group_Tegang")
theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 8
text = "2"

