theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 8
text = "5"

[node name="Adil" type="VBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 1

[node name="Q" type="Label" parent="VBox/Adil"]
layout_mode = 2
theme_override_font_sizes/font_size = 8
text = "Seberapa adil kekalahan/kemenangannya? (1 tidak adil - 5 adil)"
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="VBox/Adil"]
layout_mode = 2
theme_override_constants/separation = 3
alignment = 1

[node name="B1" type="Button" parent="VBox/Adil/Buttons"]
custom_minimum_size = Vector2(18, 16)
layout_mode = 2
focus_mode = 0
toggle_mode = true
button_group = SubResource("Group_Adil")
theme_override_styles/normal = SubResource("StyleBox_btn")
theme_override_font_sizes/font_size = 8
